# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 26
lifetime 0.45
lifetimeRandom 0.3
radius 0.2
direction 0 1 0
spread 1
speed 6
speedRandom 0.5
gravity 4
drag 4
sizeStart 0.22
sizeEnd 0.02
colorStart #FFF6C8FF
colorEnd #FFB43200
softness 0.3
spin 1.5
additive true
