# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 24
lifetime 1.6
lifetimeRandom 0.4
radius 0.6
direction 0 1 0
spread 0.8
speed 2.5
speedRandom 0.5
gravity -1
drag 1.5
sizeStart 0.6
sizeEnd 1.8
colorStart #3A3A40C0
colorEnd #5A5A6000
softness 1
additive false
