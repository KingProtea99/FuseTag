# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 12
lifetime 0.6
lifetimeRandom 0.4
radius 0.35
direction 0 1 0
spread 1
speed 1.8
speedRandom 0.5
gravity -0.2
drag 3
sizeStart 0.3
sizeEnd 0.7
colorStart #C8B89AA0
colorEnd #C8B89A00
softness 1
additive false
