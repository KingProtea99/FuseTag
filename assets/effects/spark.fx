# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 3
lifetime 0.35
lifetimeRandom 0.4
radius 0.03
direction 0 1 0
spread 0.7
speed 2.5
speedRandom 0.6
gravity 6
drag 1.5
sizeStart 0.08
sizeEnd 0.01
colorStart #FFE08AFF
colorEnd #FF5A1000
softness 0.4
additive true
