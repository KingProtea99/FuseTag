# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 14
lifetime 0.7
lifetimeRandom 0.4
radius 0.6
direction 0 1 0
spread 0.9
speed 3
speedRandom 0.5
gravity 5
drag 2
sizeStart 0.18
sizeEnd 0.08
colorStart #5FAE4AFF
colorEnd #3C7A3000
softness 0.3
spin 1.2
additive false
