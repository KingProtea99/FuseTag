# MealKit particle effect. Edit it in the editor's [Feedback] panel.
@format effect 1
count 60
lifetime 0.55
lifetimeRandom 0.4
radius 0.4
direction 0 1 0
spread 1
speed 11
speedRandom 0.6
gravity 5
drag 3
sizeStart 0.5
sizeEnd 0.05
colorStart #FFE6A0FF
colorEnd #FF3C0A00
softness 0.5
additive true
